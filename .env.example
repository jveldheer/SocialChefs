# YouTube Data API v3
YT_API_KEY=

# TikTok API (Open/Business API)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=

# Admin password for refresh/reindex endpoints
ADMIN_PASSWORD=admin123

# Demo mode (set to true to use fixtures without API keys)
DEMO_MODE=true

# Database
DATABASE_URL=file:./data/social-chef.db

# Node environment
NODE_ENV=development
